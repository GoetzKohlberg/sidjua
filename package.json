{
  "name": "sidjua",
  "version": "1.0.1",
  "description": "SIDJUA Free — Multi-Agent Governance Framework",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "sidjua": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && mkdir -p dist/roles dist/divisions dist/knowledge dist/i18n/messages locales dist/api/static && cp src/i18n/messages/en.json dist/i18n/messages/en.json && cp src/core/backup-checkpoint-worker.cjs dist/backup-checkpoint-worker.cjs && cp src/defaults/roles/*.yaml dist/roles/ && cp src/defaults/divisions/*.yaml dist/divisions/ && cp src/defaults/knowledge/*.md dist/knowledge/ && cp src/defaults/approved-providers.json dist/ && mkdir -p dist/defaults && cp src/defaults/org-chart-default.json dist/defaults/ && cp src/locales/*.json locales/ && cp src/api/static/glasscheibe-widget.js dist/api/static/ && node -e \"const v=JSON.parse(require('fs').readFileSync('package.json','utf8')).version;require('fs').writeFileSync('dist/.version',v);\"",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "i18n:check": "npx tsx scripts/check-i18n-completeness.ts",
    "i18n:sync": "npx tsx scripts/sync-locales.ts && cp src/locales/*.json locales/",
    "i18n:sync:dry": "npx tsx scripts/sync-locales.ts --dry",
    "audit:check": "npm audit --audit-level=high",
    "docs:api": "typedoc",
    "docs:validate": "bash scripts/docs-check.sh",
    "docs:deps": "npx depcruise --output-type json src/ > docs/.build/deps.json",
    "docs:filemap": "npx tsx scripts/extract-file-map.ts",
    "docs:context": "npx tsx scripts/generate-llm-context.ts",
    "docs:diagrams": "npx tsx scripts/generate-dev-diagrams.ts",
    "docs:render": "npx mmdc -i docs/dev/ARCHITECTURE.md -o docs/dev/img/architecture.svg -c docs/.build/mermaid-config.json",
    "docs:generate": "npm run docs:deps && npm run docs:filemap && npm run docs:context && npm run docs:diagrams",
    "benchmark": "npx tsx src/__benchmarks__/run.ts",
    "benchmark:quick": "npx tsx src/__benchmarks__/run.ts --scenario short-burst",
    "benchmark:full": "npx tsx src/__benchmarks__/run.ts --all"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "ai",
    "governance",
    "agents",
    "automation",
    "multi-agent",
    "llm",
    "orchestration",
    "audit",
    "compliance",
    "open-source"
  ],
  "author": "Götz Kohlberg",
  "homepage": "https://sidjua.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/GoetzKohlberg/sidjua.git"
  },
  "bugs": {
    "url": "https://github.com/GoetzKohlberg/sidjua/issues"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^11.12.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.3.2",
    "@types/papaparse": "^5.5.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/ssh2": "^1.15.5",
    "@types/ws": "^8.18.1",
    "dependency-cruiser": "^17.3.10",
    "knip": "^6.3.0",
    "sharp": "^0.34.5",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.18",
    "typedoc-plugin-markdown": "^4.11.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "^0.0.40",
    "@anthropic-ai/sdk": "0.78.0",
    "@slack/bolt": "^4.6.0",
    "@types/adm-zip": "^0.5.7",
    "@types/archiver": "^7.0.0",
    "@types/nodemailer": "^7.0.11",
    "@types/shell-quote": "^1.7.5",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^3.3.0",
    "adm-zip": "^0.5.16",
    "archiver": "^7.0.1",
    "argon2": "0.44.0",
    "baileys": "^7.0.0-rc.9",
    "better-sqlite3": "12.8.0",
    "cheerio": "^1.2.0",
    "commander": "^14.0.3",
    "cron-parser": "^5.5.0",
    "discord.js": "^14.25.1",
    "hono": "^4.12.3",
    "imapflow": "^1.2.16",
    "mammoth": "^1.11.0",
    "nodemailer": "^8.0.3",
    "openai": "6.25.0",
    "papaparse": "^5.5.3",
    "pdf-parse": "^2.4.5",
    "shell-quote": "^1.8.3",
    "ssh2": "^1.17.0",
    "telegraf": "^4.16.3",
    "tesseract.js": "^7.0.0",
    "tiktoken": "^1.0.22",
    "ws": "^8.20.0",
    "xlsx": "^0.18.5",
    "yaml": "^2.8.2",
    "yauzl": "^3.2.1",
    "yazl": "^3.3.1",
    "zod": "^4.3.6"
  }
}
