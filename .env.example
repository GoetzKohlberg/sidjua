# SIDJUA Configuration
# Copy to .env and customize (`.env` is gitignored; `.env.example` is tracked)
#
# docker-compose usage:
#   cp .env.example .env
#   # Edit .env to set your API keys, then:
#   docker compose up -d

# Image version for docker-compose (matches git tag / release)
SIDJUA_VERSION=1.1.0

# Server
SIDJUA_PORT=3000
SIDJUA_HOST=0.0.0.0
NODE_ENV=production

# Data directory: controlled by Dockerfile ENV SIDJUA_DATA_DIR=/data in V1.1.0.
# Override here only for manual/non-Docker installs.

# Qdrant (Vector Database)
SIDJUA_QDRANT_URL=http://localhost:6333

# LLM Providers (configure at least one)
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_AI_API_KEY=...
# CLOUDFLARE_ACCOUNT_ID=...
# CLOUDFLARE_API_TOKEN=...

# API Authentication
# Generate with: sidjua api-key generate
# SIDJUA_API_KEY=
